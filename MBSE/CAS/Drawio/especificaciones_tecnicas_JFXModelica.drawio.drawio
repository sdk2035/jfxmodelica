        </mxCell>
        <mxCell id="et_GvkiXjjocm9gYy2zo-10" parent="et_GvkiXjjocm9gYy2zo-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RNF-01: Rendimiento y Escalabilidad Cloud&lt;/b&gt;&lt;br&gt;• Despliegue distribuido en contenedores (Docker/K8s).&lt;br&gt;• Renderizado 3D a ≥ 30 FPS en navegadores web." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="45" as="geometry" />
        </mxCell>
        <mxCell id="et_GvkiXjjocm9gYy2zo-11" parent="et_GvkiXjjocm9gYy2zo-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RNF-02: Disponibilidad y Comunicación Asíncrona&lt;/b&gt;&lt;br&gt;• Frontend web asíncrono para streaming de telemetría.&lt;br&gt;• Tolerancia a fallos en trabajos de simulación extensos." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="130" as="geometry" />
