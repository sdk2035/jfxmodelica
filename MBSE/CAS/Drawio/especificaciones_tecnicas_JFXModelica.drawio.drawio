        <mxCell id="et_GvkiXjjocm9gYy2zo-4" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#1e3a8a;" value="1. REQUISITOS FUNCIONALES (RF)" vertex="1">
          <mxGeometry height="420" width="480" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="et_GvkiXjjocm9gYy2zo-5" parent="et_GvkiXjjocm9gYy2zo-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-01: Copiloto IA (Modelica Assistant)&lt;/b&gt;&lt;br&gt;• Generación de código Modelica vía prompts LN.&lt;br&gt;• Autocorrección de ecuaciones y singularidades." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="45" as="geometry" />
        </mxCell>
        <mxCell id="et_GvkiXjjocm9gYy2zo-6" parent="et_GvkiXjjocm9gYy2zo-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-02: Simulación Multifísica Cloud Integrada&lt;/b&gt;&lt;br&gt;• Resolución DAEs mediante OpenModelica / JModelica.&lt;br&gt;• Barridos paramétricos e incertidumbres en paralelo." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="130" as="geometry" />
        </mxCell>
        <mxCell id="et_GvkiXjjocm9gYy2zo-7" parent="et_GvkiXjjocm9gYy2zo-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-03: Acoplamiento CAE (CFD / FEA / Aero)&lt;/b&gt;&lt;br&gt;• Integración con OpenFOAM (CFD) y CalculiX (FEA).&lt;br&gt;• Simulación dinámica de vuelo con JSBSim." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="215" as="geometry" />
        </mxCell>
        <mxCell id="et_GvkiXjjocm9gYy2zo-8" parent="et_GvkiXjjocm9gYy2zo-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-04: Gemelos Digitales e Interoperabilidad&lt;/b&gt;&lt;br&gt;• Importación y exportación bajo estándar FMI (FMU).&lt;br&gt;• Proyección 3D (React/Three.js) de mapas térmicos y flujo." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="300" as="geometry" />
        </mxCell>
        <mxCell id="et_GvkiXjjocm9gYy2zo-9" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8fafc;strokeColor=#10b981;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#065f46;" value="2. REQUISITOS NO FUNCIONALES (RNF)" vertex="1">
